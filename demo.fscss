/* demo.fscss — real usage of patterns.fscss, not a token showcase.
Compile with: fscss demo.fscss demo.css
Or preview instantly with the browser runtime (see demo.html).
*/

@import(
(pattern-root, patterns) 
from "./patterns.fscss"
)

@pattern-root()
@patterns(0.5)

/* ---------- base ---------- */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  color: #1e1b2e;
  background: #fbfaff;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  centered max width container with side padding max: 1100px pad: 24px
}

/* ---------- header ---------- */

.site-header {
  sticky translucent header bar with blur bg: rgba(255, 255, 255, 0.85)
}

.site-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: 14px;
}

.logo {
  font-weight: 700;
  font-size: 1.1rem;
  color: #344466;
}

.nav-links {
  display: flex;
  gap: 24px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links a {
  font-weight: 500;
  font-size: 0.9rem;
  color: #4a4560;
}

.btn-primary {
  solid filled primary button bg: #344466
}

.btn-primary {
  lift up on hover with stronger shadow lift: -2px
}

.btn-ghost {
  ghost outline button with accent border
}

.btn-ghost {
  scale slightly on hover scale: 1.03
}

/* ---------- hero ---------- */

.hero {
  vibrant two tone gradient card from: #121212 to: #676756 color: #fff
}

.hero {
  smooth fade in animation from bottom duration: 0.7s
}

.hero-badge {
  badge or tag with rounded pill shape bg: rgba(255, 255, 255, 0.2) color: #fff
}

.hero h1 {
  font-size: 2.2rem;
  margin: 16px 0 8px;
}

.hero p {
  max-width: 480px;
  opacity: 0.9;
  margin-bottom: 24px;
}

.hero-actions {
  display: flex;
  gap: 12px;
}

.hero .btn-ghost {
  border-color: rgba(255, 255, 255, 0.6);
  color: #fff;
}

/* ---------- features ---------- */

.features-grid {
  responsive auto fit grid layout min: 240px gap: 24px
}

.feature-card {
  soft elevated surface card with subtle shadow
}

.feature-card {
  lift up on hover with stronger shadow lift: -6px
}

.feature-icon {
  font-size: 1.6rem;
  margin-bottom: 12px;
}

.feature-card h3 {
  margin: 0 0 8px;
  font-size: 1.05rem;
}

.feature-card p {
  margin: 0;
  font-size: 0.9rem;
  color: #6b6480;
}

/* ---------- divider ---------- */

.section-divider {
  subtle horizontal divider line color: #eae7f5 gap: 48px
}

/* ---------- form ---------- */

.form-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.form-row label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #4a4560;
}

.form-input {
  modern input field with soft focus ring
}

.form-input {
  accessible focus ring outline on keyboard focus color: #344466
}

.form-input {
  disabled muted low opacity state
}

/* ---------- alerts ---------- */

.alert-success {
  status alert banner with icon spacing bg: #eafaf1 color: #146c43 border: #b7e4c7
}

.alert-error {
  status alert banner with icon spacing bg: #fdecec color: #b42318 border: #f5b5b0
}

/* ---------- profile row ---------- */

.profile-row {
  display: flex;
  align-items: center;
  gap: 14px;
  position: relative;
}

.avatar {
  circular avatar image with ring border size: 56px ring: #ffffff
}

.pro-badge {
  badge or tag with rounded pill shape bg: #344466 color: #fff
}

.tooltip {
  dark elegant tooltip or popover 
}

.tooltip {
  position: absolute;
  top: -46px;
  left: 0;
  width: 70px;
  font-size: 9px;
  padding: 5px;
}

/* ---------- progress ---------- */

.progress-track {
  progress bar track
}

.progress-fill {
  progress bar fill indicator fill: #344466
}

/* ---------- tabs ---------- */

.tabs {
  display: flex;
  gap: 24px;
  border-bottom: 1px solid #344466;
}

.tab {
  background: none;
  border: none;
  padding: 10px 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: #8b84a0;
  cursor: pointer;
}

.tab.is-active {
  color: #344466;
}

.tab.is-active {
  underline tab active indicator color: #344466 thick: 2px
}

.tab-panel {
  display: none;
  padding-block: 20px;
  font-size: 0.9rem;
  color: #4a4560;
}

.tab-panel.is-active {
  display: block;
}

/* ---------- skeleton loading ---------- */

.skeleton-line {
  skeleton loading shimmer placeholder
}

.skeleton-line {
  height: 14px;
  margin-bottom: 10px;
}

/* ---------- toggle ---------- */

.toggle-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.toggle {
  toggle switch track bg: #777999 width: 44px
}

.toggle.is-on {
  background: #344466;
}

.toggle-thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s ease;
}

.toggle.is-on .toggle-thumb {
  transform: translateX(18px);
}

/* ---------- scrollable list ---------- */

.scroll-list {
  custom thin scrollbar styling thumb: #767999
}

.scroll-list {
  max-height: 180px;
  overflow-y: auto;
  border: 1px solid #eae7f5;
  border-radius: var(--pattern-radius-md);
}

.scroll-item {
  padding: 10px 14px;
  font-size: 0.85rem;
  border-bottom: 1px solid #f2f0f9;
}

/* ---------- simple footer ---------- */

.site-footer {
  padding-block: 32px;
  font-size: 0.85rem;
  color: #8b84a0;
  text-align: center;
}
