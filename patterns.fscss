/* patterns.fscss — demo pattern library with @match inputs (FSCSS 1.2.4+)
   https://github.com/fscss-ttr/patterns.fscss
*/

@define pattern-root(sel:root){`
:@use(sel) {
  /* Design tokens — defaults when @match finds nothing */
  --pattern-accent: #764ba2;
  --pattern-accent-light: #667eea;
  --pattern-accent-dark: #5a3d8a;
  --pattern-surface: #ffffff;
  --pattern-surface-soft: #f8f7fc;
  --pattern-text: #e2e0f0;
  --pattern-text-muted: #a89fc4;
  --pattern-text-on-accent: #ffffff;
  --pattern-radius-lg: 16px;
  --pattern-radius-md: 10px;
  --pattern-radius-sm: 6px;
  --pattern-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  --pattern-shadow-hover: 0 16px 40px rgba(0, 0, 0, 0.35);
  --pattern-pad-lg: 28px;
  --pattern-pad-md: 12px 24px;
  --pattern-pad-sm: 8px 16px;
  --pattern-transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --pattern-border-width: 2px;
}
`}

@define patterns(thr:0.65){`

/* ========== Cards ========== */

pattern(@use(thr): "beautiful gradient hello world card bg from to color", `
  border-radius: var(--pattern-radius-lg);
  padding: var(--pattern-pad-lg);
  background: linear-gradient(
    135deg,
    @match(from:?\s*([#\w(),.%\s-]+)) @match(bg:?\s*([#\w(),.%\s-]+)) var(--pattern-accent-light),
    @match(to:?\s*([#\w(),.%\s-]+)) var(--pattern-accent)
  );
  color: @match(color:?\s*([#\w()-]+)) @match(text:?\s*([#\w()-]+)) var(--pattern-text);
  box-shadow: var(--pattern-shadow);
  transition: var(--pattern-transition);
`)

pattern(@use(thr): "soft elevated white card with subtle shadow radius", `
  background: @match(bg:?\s*([#\w()-]+)) @match(background:?\s*([#\w()-]+)) var(--pattern-surface);
  border-radius: @match(radius:?\s*([\d.]+(?:px|rem|em)?)) var(--pattern-radius-lg);
  padding: var(--pattern-pad-lg);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(0, 0, 0, 0.04);
`)

/* ========== Buttons ========== */

pattern(@use(thr): "white background button with purple label color bg", `
  border: none;
  border-radius: var(--pattern-radius-md);
  padding: var(--pattern-pad-md);
  background: @match(bg:?\s*([#\w()-]+)) @match(background:?\s*([#\w()-]+)) var(--pattern-surface);
  color: @match(color:?\s*([#\w()-]+)) @match(label:?\s*([#\w()-]+)) var(--pattern-accent);
  font-weight: 600;
  cursor: pointer;
  transition: var(--pattern-transition);
`)

pattern(@use(thr): "solid purple primary button with white label bg color", `
  border: none;
  border-radius: var(--pattern-radius-md);
  padding: var(--pattern-pad-md);
  background: @match(bg:?\s*([#\w()-]+)) @match(background:?\s*([#\w()-]+)) var(--pattern-accent);
  color: @match(color:?\s*([#\w()-]+)) @match(label:?\s*([#\w()-]+)) var(--pattern-text-on-accent);
  font-weight: 600;
  cursor: pointer;
  transition: var(--pattern-transition);
`)

pattern(@use(thr): "ghost outline button with purple border color", `
  background: transparent;
  border: 2px solid @match(border:?\s*([#\w()-]+)) @match(color:?\s*([#\w()-]+)) var(--pattern-accent);
  color: @match(color:?\s*([#\w()-]+)) @match(text:?\s*([#\w()-]+)) var(--pattern-accent);
  border-radius: var(--pattern-radius-md);
  padding: var(--pattern-pad-md);
  font-weight: 600;
  cursor: pointer;
  transition: var(--pattern-transition);
`)

/* ========== Hover ========== */

pattern(@use(thr): "lift up on hover with stronger shadow lift", `
  transition: var(--pattern-transition);
  &:hover {
    transform: translateY(@match(lift:?\s*(-?[\d.]+(?:px|rem)?)) -4px);
    box-shadow: var(--pattern-shadow-hover);
  }
`)

pattern(@use(thr): "scale slightly on hover scale", `
  transition: transform 0.2s ease;
  &:hover {
    transform: scale(@match(scale:?\s*([\d.]+)) 1.05);
  }
`)

pattern(@use(thr): "glow purple on hover glow color", `
  transition: box-shadow 0.3s ease;
  &:hover {
    box-shadow: 0 0 20px @match(glow:?\s*([#\w(),.%\s-]+)) @match(color:?\s*([#\w(),.%\s-]+)) rgba(118, 75, 162, 0.5);
  }
`)

/* ========== Animations ========== */

pattern(@use(thr): "smooth fade in animation from bottom duration", `
  animation: fadeInUp @match(duration:?\s*([\d.]+s?)) @match(time:?\s*([\d.]+s?)) 0.6s ease forwards;
`)

pattern(@use(thr): "gentle pulse attention animation duration", `
  animation: gentlePulse @match(duration:?\s*([\d.]+s?)) 2s ease-in-out infinite;
`)

pattern(@use(thr): "spin loading animation duration", `
  animation: spin @match(duration:?\s*([\d.]+s?)) 1s linear infinite;
`)

pattern(@use(thr): "fade in up keyframes", `
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
`)

pattern(@use(thr): "gentle pulse keyframes", `
@keyframes gentlePulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.03); opacity: 0.9; }
}
`)

pattern(@use(thr): "spin keyframes for loader", `
@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
`)

/* ========== Components ========== */

pattern(@use(thr): "modern input field with soft focus ring border", `
  border: 1.5px solid @match(border:?\s*([#\w()-]+)) #e0dcec;
  border-radius: var(--pattern-radius-sm);
  padding: 12px 16px;
  background: @match(bg:?\s*([#\w()-]+)) var(--pattern-surface);
  color: @match(color:?\s*([#\w()-]+)) #333;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
`)

pattern(@use(thr): "badge or tag with rounded pill shape bg color", `
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  border-radius: 999px;
  background: @match(bg:?\s*([#\w()-]+)) @match(background:?\s*([#\w()-]+)) var(--pattern-accent-light);
  color: @match(color:?\s*([#\w()-]+)) @match(text:?\s*([#\w()-]+)) white;
  font-size: 0.8rem;
  font-weight: 600;
`)

pattern(@use(thr): "glass morphism frosted glass effect blur", `
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(@match(blur:?\s*([\d.]+(?:px)?)) 12px);
  -webkit-backdrop-filter: blur(@match(blur:?\s*([\d.]+(?:px)?)) 12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--pattern-radius-lg);
`)

pattern(@use(thr): "dark elegant tooltip or popover bg color", `
  background: @match(bg:?\s*([#\w()-]+)) @match(background:?\s*([#\w()-]+)) #1a1a2e;
  color: @match(color:?\s*([#\w()-]+)) @match(text:?\s*([#\w()-]+)) #eee;
  padding: 10px 14px;
  border-radius: var(--pattern-radius-sm);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  font-size: 0.875rem;
`)

pattern(@use(thr): "border initial width color", `
  border: @match(width:?\s*([\d.]+(?:px)?)) var(--pattern-border-width) solid @match(color:?\s*([#\w()-]+)) currentColor;
`)

`}
